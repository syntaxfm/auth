{
	"name": "syntax-auth",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"d1:migration:create": "wrangler d1 migrations create syntax-auth",
		"d1:migrate:local": "wrangler d1 migrations apply syntax-auth --local",
		"d1:migrate:remote": "wrangler d1 migrations apply syntax-auth --remote",
		"deploy": "pnpm build && wrangler deploy --env=\"\"",
		"oauth:register": "tsx scripts/register_oauth_client.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.6.23",
		"@better-auth/oauth-provider": "1.6.23",
		"@opentelemetry/api": "^1.9.1",
		"better-auth": "1.6.23",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260722.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.0.16",
		"wrangler": "^4.113.0"
	},
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": "22.x"
	}
}
