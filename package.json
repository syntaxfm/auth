{
	"name": "syntax-auth",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/local_server.js dev",
		"build": "vite build",
		"preview": "node scripts/local_server.js preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"test": "tsx --test 'src/**/*.test.ts' 'packages/auth-local/test/*.test.js'",
		"format": "prettier --write .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"d1:migration:create": "wrangler d1 migrations create syntax-auth",
		"d1:migrate:local": "wrangler d1 migrations apply syntax-auth --local --env local",
		"d1:migrate:remote": "wrangler d1 migrations apply syntax-auth --remote",
		"deploy": "pnpm build && wrangler deploy --env=\"\"",
		"oauth:register": "tsx scripts/register_oauth_client.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.6.33",
		"@better-auth/oauth-provider": "1.6.33",
		"@opentelemetry/api": "^1.10.0",
		"better-auth": "1.6.33",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261025.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^25.9.9",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": "22.x"
	}
}
