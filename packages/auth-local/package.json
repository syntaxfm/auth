{
	"name": "@syntaxfm/auth-local",
	"version": "1.0.0",
	"description": "Starts the shared local Syntax Auth for any Syntax app's dev server, and serves its sign-in and sign-out through the app's own address.",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"bin": {
		"syntax-auth-local": "./bin.js"
	},
	"scripts": {
		"test": "node --test 'test/*.test.js'"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"container.js",
		"presence.js",
		"update.js",
		"bin.js",
		"plugin.js",
		"gateway.js",
		"app_origin.js",
		"local_auth.js",
		"local_developer.js",
		"pages.js"
	],
	"engines": {
		"node": ">=22"
	}
}
